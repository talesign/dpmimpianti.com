---
import "../styles/global.css";
import Layout, { type LayoutProps } from "../components/layout.astro";
import Hero from "../components/home/hero.astro";
import ValueProposition from "../components/home/value-proposition.astro";
import ServicesListing from "../components/services-listing.astro";
import PartnerKronoterm from "../components/home/partner-kronoterm.astro";
import About from "../components/home/about.astro";
import Bodycopy from "../components/home/bodycopy.astro";

const props: LayoutProps = {
  content: {
    title: "Tecnico Frigorista in Toscana | DPM Impianti",
    url: "/",
    description: "Assistenza e riparazione impianti frigoriferi e pompe di calore in Toscana. Refrigerazione commerciale e industriale con certificazioni FGAS e SIERT.",
    ogTitle: "DPM Impianti — Tecnico Frigorista in Toscana",
    ogType: "website",
    ogDescription: "Il punto di riferimento in Toscana per la refrigerazione commerciale e industriale. Interventi rapidi e risolutivi, con certificazioni FGAS e SIERT.",
    ogImage: "",
    twitterTitle: "DPM Impianti — Tecnico Frigorista in Toscana",
    twitterDescription: "Il punto di riferimento in Toscana per la refrigerazione commerciale e industriale. Interventi rapidi e risolutivi, con certificazioni FGAS e SIERT.",
    twitterImage: "",
  },
};

const servicesListingTitle = "Di cosa hai bisogno oggi?";
const servicesListingDescritpion = "Tutti i servizi che offro nello specifico.";
---

<Layout content={props.content}>
  <Hero />
  <ValueProposition />
  <ServicesListing
    title={servicesListingTitle}
    description={servicesListingDescritpion}
  />
  <PartnerKronoterm />
  <About />
  <Bodycopy />
</Layout>
