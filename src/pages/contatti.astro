---
import "../styles/global.css";
import ContactForm from "../components/form.tsx";
import Layout, { type LayoutProps } from "../components/layout.astro";
const props: LayoutProps = {
  content: {
    title: "Contatti | DPM Impianti di Mirco Del Piano",
    url: "/contatti",
    description:
      "Contatta Mirco Del Piano per assistenza tecnica su climatizzazione, refrigerazione e pompe di calore a Figline Valdarno (FI). Chiama il 334 688 3754 o compila il modulo.",
    ogTitle: "Contatta DPM Impianti | Assistenza Tecnica Diretta",
    ogType: "website",
    ogDescription:
      "Richiedi un preventivo o assistenza tecnica qualificata per impianti di climatizzazione e refrigerazione. Risposta diretta da Mirco Del Piano, senza intermediari.",
    ogImage: "",
    twitterTitle: "Contatta DPM Impianti | Assistenza Tecnica Diretta",
    twitterDescription:
      "Richiedi un preventivo o assistenza tecnica qualificata per impianti di climatizzazione e refrigerazione. Risposta diretta da Mirco Del Piano, senza intermediari.",
    twitterImage: "",
  },
};
---

<Layout content={props.content}>
  <div class="relative isolate bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2">
      <div
        class="relative px-6 pt-24 pb-20 sm:pt-32 lg:static lg:px-8 lg:py-48"
      >
        <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
          <div
            class="absolute inset-y-0 left-0 -z-10 w-full overflow-hidden bg-gray-100 ring-1 ring-gray-900/10 lg:w-1/2"
          >
            <svg
              aria-hidden="true"
              class="absolute inset-0 size-full mask-[radial-gradient(100%_100%_at_top_right,white,transparent)] stroke-gray-200"
            >
              <defs>
                <pattern
                  id="83fd4e5a-9d52-42fc-97b6-718e5d7ee527"
                  width="200"
                  height="200"
                  x="100%"
                  y="-1"
                  patternUnits="userSpaceOnUse"
                >
                  <path d="M130 200V.5M.5 .5H200" fill="none"></path>
                </pattern>
              </defs>
              <rect
                width="100%"
                height="100%"
                stroke-width="0"
                class="fill-white"></rect>
              <svg x="100%" y="-1" class="overflow-visible fill-gray-50">
                <path d="M-470.5 0h201v201h-201Z" stroke-width="0"></path>
              </svg>
              <rect
                width="100%"
                height="100%"
                fill="url(#83fd4e5a-9d52-42fc-97b6-718e5d7ee527)"
                stroke-width="0"></rect>
            </svg>
            <div
              aria-hidden="true"
              class="absolute top-[calc(100%-13rem)] -left-56 hidden transform-gpu blur-3xl lg:top-[calc(50%-7rem)] lg:left-[max(-14rem,calc(100%-59rem))]"
            >
              <div
                style="clip-path: polygon(74.1% 56.1%, 100% 38.6%, 97.5% 73.3%, 85.5% 100%, 80.7% 98.2%, 72.5% 67.7%, 60.2% 37.8%, 52.4% 32.2%, 47.5% 41.9%, 45.2% 65.8%, 27.5% 23.5%, 0.1% 35.4%, 17.9% 0.1%, 27.6% 23.5%, 76.1% 2.6%, 74.1% 56.1%)"
                class="aspect-1155/678 w-288.75 bg-linear-to-br from-[#80caff] to-[#4f46e5] opacity-10"
              >
              </div>
            </div>
          </div>
          <h2
            class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
          >
            Contatta Mirco Del Piano.
          </h2>
          <p class="mt-6 text-lg/8 text-gray-600">
            Assistenza tecnica qualificata per la tua azienda o la tua
            abitazione. Rispondo personalmente, senza intermediari.
          </p>
          <dl class="mt-10 space-y-4 text-base/7 text-gray-600">
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Sede Operativa</span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  data-slot="icon"
                  aria-hidden="true"
                  class="h-7 w-6 text-gray-400"
                >
                  <path
                    d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </dt>
              <dd>
                Via Della Comunità Europea<br />Figline Valdarno – FI (Zona
                Coop)
              </dd>
            </div>
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Telefono</span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  data-slot="icon"
                  aria-hidden="true"
                  class="h-7 w-6 text-gray-400"
                >
                  <path
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </dt>
              <dd>
                <a href="tel:+393346883754" class="hover:text-gray-900"
                  >+39 334 688 3754</a
                >
              </dd>
            </div>
            <div class="flex gap-x-4">
              <dt class="flex-none">
                <span class="sr-only">Email</span>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  data-slot="icon"
                  aria-hidden="true"
                  class="h-7 w-6 text-gray-400"
                >
                  <path
                    d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </dt>
              <dd>
                <a
                  href="mailto:mircodelpiano@outlook.it"
                  class="hover:text-gray-900">mircodelpiano@outlook.it</a
                >
              </dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="px-6 pt-20 pb-24 sm:pb-32 lg:px-8 lg:py-48">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</Layout>
