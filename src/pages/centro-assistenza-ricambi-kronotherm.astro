---
import "../styles/global.css";
import Hero from "../components/kronoterm/hero.astro";
import Partner from "../components/kronoterm/partner.astro";
import Layout, { type LayoutProps } from "../components/layout.astro";
import Contact from "../components/kronoterm/contact.astro";
const props: LayoutProps = {
  content: {
    title:
      "Centro Assistenza Autorizzato e Ricambi Kronoterm Toscana | DPM Impianti",
    url: "/centro-assistenza-ricambi-kronotherm",
    description:
      "Centro assistenza autorizzato Kronoterm in Toscana. Tecnici formati dalla casa madre, ricambi originali certificati e diagnostica dedicata per pompe di calore Kronoterm.",
    ogTitle: "Centro Assistenza Autorizzato e Ricambi Kronoterm Toscana",
    ogType: "website",
    ogDescription:
      "Partner ufficiale Kronoterm: assistenza tecnica specializzata, ricambi originali garantiti e diagnostica dedicata per la tua pompa di calore.",
    ogImage: "",
    twitterTitle: "Centro Assistenza Autorizzato e Ricambi Kronoterm Toscana",
    twitterDescription:
      "Partner ufficiale Kronoterm: assistenza tecnica specializzata, ricambi originali garantiti e diagnostica dedicata per la tua pompa di calore.",
    twitterImage: "",
  },
};
---

<Layout content={props.content}>
  <Hero />
  <Partner />
  <Contact />
</Layout>
