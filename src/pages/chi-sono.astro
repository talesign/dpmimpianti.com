---
import "../styles/global.css";
import Layout, { type LayoutProps } from "../components/layout.astro";
import Hero from "../components/about/hero.astro";
import Bodycopy from "../components/about/experience.astro";
import Certifications from "../components/about/certifications.astro";
import Mission from "../components/about/mission.astro";

const props: LayoutProps = {
  content: {
    title:
      "Chi Sono - Mirco Del Piano | Tecnico Frigorista Certificato nel Valdarno",
    url: "/chi-sono",
    description:
      "Mirco Del Piano, tecnico frigorista specializzato in refrigerazione commerciale e industriale a Figline Valdarno. Certificazione F-GAS Categoria I e SIERT. Riparazione e manutenzione impianti frigoriferi in Toscana.",
    ogTitle:
      "Chi Sono - Mirco Del Piano | Tecnico Frigorista Certificato nel Valdarno",
    ogType: "website",
    ogDescription:
      "Tecnico frigorista certificato F-GAS e SIERT, specializzato in impianti frigoriferi commerciali e industriali. Esperienza, competenza e onestà al servizio delle aziende del Valdarno e della Toscana.",
    ogImage: "",
    twitterTitle:
      "Chi Sono - Mirco Del Piano | Tecnico Frigorista Certificato nel Valdarno",
    twitterDescription:
      "Tecnico frigorista certificato F-GAS e SIERT, specializzato in impianti frigoriferi commerciali e industriali. Esperienza, competenza e onestà al servizio delle aziende del Valdarno e della Toscana.",
    twitterImage: "",
  },
};
---

<Layout content={props.content}>
  <Hero />
  <Bodycopy />
  <Certifications />
  <Mission />
</Layout>
