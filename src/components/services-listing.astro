---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

export interface ServicesListingProps {
  title?: string;
  description?: string;
}
type Props = ServicesListingProps;
const { title, description } = Astro.props;

const services = (await getCollection("servizi")).sort(
  (a, b) => b.data.order - a.data.order,
);
---

<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      {
        title && (
          <h2 class="text-4xl font-semibold tracking-tight text-balance text-gray-900 sm:text-5xl">
            {title}
          </h2>
        )
      }
      {description && <p class="mt-2 text-lg/8 text-gray-600">{description}</p>}
    </div>
    <div
      class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3"
    >
      {
        services.map((service) => (
          <article class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 px-8 pt-80 pb-8 sm:pt-48 lg:pt-80">
            <Image
              src={service.data.listImage}
              width={500}
              height={500}
              alt={service.data.listImageAlt}
              class="absolute inset-0 -z-10 size-full object-cover"
            />
            <div class="absolute inset-0 -z-10 bg-linear-to-t from-gray-900 via-gray-900/40" />
            <div class="absolute inset-0 -z-10 rounded-2xl inset-ring inset-ring-gray-900/10" />

            <h3 class="mb-3 text-lg/6 font-semibold text-white">
              <a href={"servizi/" + service.data.slug}>
                <span class="absolute inset-0" />
                {service.data.title}
              </a>
            </h3>
            <div class="flex flex-wrap items-center gap-y-1 overflow-hidden text-sm/6 text-gray-300">
              <p class="">{service.data.listDescription}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</div>
