---
export interface ServiceBodycopyProps {
  label: string;
  title: string;
  description: string;
  cta: string;
}
type Props = ServiceBodycopyProps;
const { label, title, description, cta } = Astro.props;
---

<div class="relative isolate bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <p class="text-base/7 font-semibold text-sky-600">
        {label}
      </p>
      <h2
        class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
      >
        {title}
      </h2>
      <p class="mt-6 text-xl/8 text-gray-700">
        {description}
      </p>
    </div>
    <div
      class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:mt-10 lg:max-w-none lg:grid-cols-12"
    >
      <div class="relative lg:order-last lg:col-span-5">
        <blockquote
          class="h-full text-xl/8 font-semibold tracking-tight text-gray-900"
        >
          <div class="sticky top-0 md:pt-8">
            <p class="pb-8">
              {cta}
            </p>
            <a
              href="/contatti"
              class="rounded-md bg-sky-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-sky-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
              >Contatti</a
            >
          </div>
        </blockquote>
      </div>
      <div
        class="max-w-xl text-base/7 text-gray-600 lg:col-span-7"
        id="bodycopy"
      >
        <slot />
      </div>
    </div>
  </div>
</div>
