---
import { Image } from "astro:assets";

export interface CtaProps {
  label: string;
  title: string;
  description: string;
  image: ImageMetadata;
}

type Props = CtaProps;
const { title, description, label, image } = Astro.props;
---

<div class="relative bg-white">
  <div
    class="relative h-80 overflow-hidden bg-sky-600 md:absolute md:left-0 md:h-full md:w-1/3 lg:w-1/2"
  >
    <Image src={image} alt={title} class="size-full object-cover" />
  </div>
  <div class="relative mx-auto max-w-7xl py-24 sm:py-32 lg:px-8 lg:py-40">
    <div
      class="pr-6 pl-6 md:ml-auto md:w-2/3 md:pl-16 lg:w-1/2 lg:pr-0 lg:pl-24 xl:pl-32"
    >
      <h2 class="text-base/7 font-semibold text-sky-600">
        {label}
      </h2>
      <p
        class="mt-2 text-4xl font-semibold tracking-tight text-gray-900 sm:text-5xl"
      >
        {title}
      </p>
      <p class="mt-6 text-base/7 text-gray-600">
        {description}
      </p>
      <div class="mt-8">
        <a
          href="/contatti"
          class="inline-flex rounded-md bg-sky-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-sky-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
        >
          Contatti
        </a>
      </div>
    </div>
  </div>
</div>
