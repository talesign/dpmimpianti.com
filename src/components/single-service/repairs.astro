---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface RepairsProps {
  label: string;
  title: string;
  description: string;
  list: {
    title: string;
    description: string;
  }[];
  commonProblems: string[];
  image: ImageMetadata;
}

type Props = RepairsProps;
const { label, title, description, list, commonProblems, image } = Astro.props;
---

<div class="overflow-hidden bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2"
    >
      <div class="lg:pt-4 lg:pr-8">
        <div class="lg:max-w-lg">
          <h2 class="text-base/7 font-semibold text-sky-600">
            {label}
          </h2>
          <p
            class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
          >
            {title}
          </p>
          <p class="mt-6 text-lg/8 text-gray-700">
            {description}
          </p>
          <dl
            class="mt-10 max-w-xl space-y-8 text-base/7 text-gray-600 lg:max-w-none"
          >
            {
              list.map((item) => (
                <div class="relative pl-9">
                  <dt class="inline font-semibold text-gray-900">
                    <svg
                      viewBox="0 0 20 20"
                      data-slot="icon"
                      aria-hidden="true"
                      class="absolute top-1 left-1 size-5 text-sky-600"
                    >
                      <circle cx="8" cy="8" r="6" fill="currentColor" />
                    </svg>
                    {item.title}
                  </dt>
                  <dd class="inline">{item.description}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <Image
        src={image}
        alt={title}
        class="w-3xl max-w-none rounded-xl shadow-xl ring-1 ring-gray-400/10 sm:w-228 md:-ml-4 lg:-ml-0"
      />
    </div>
  </div>
</div>
