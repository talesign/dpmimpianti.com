---
import { ChevronRightIcon } from "@heroicons/react/20/solid";
import { Image } from "astro:assets";
import { type Link } from "../../utils";
import { phone } from "../../content/shared";

type HomeHeroContent = {
  title: string;
  description: string;
  primaryButton: Link;
  secondaryButton: Link;
  label?: string;
  topButton?: Link;
};

const content: HomeHeroContent = {
  title:
    "Assistenza e riparazione impianti frigoriferi e pompe di calore in Toscana.",
  description:
    "Il punto di riferimento in Toscana per la refrigerazione commerciale e industriale. Interventi rapidi e risolutivi, con certificazioni FGAS e SIERT per ogni tipo di impianto. Senza girarci intorno.",
  primaryButton: {
    label: "Contatti",
    link: "/contatti",
  },
  secondaryButton: {
    label: "Tutti i servizi",
    link: "/servizi",
  },
};

import image from "../../content/servizi/assistenza-frigoriferi-industriali-2.jpg";
const imageAlt = "Assistenza tecnica e riparazioni circuiti frigoriferi";
---

<div class="bg-white">
  <div
    class="relative isolate overflow-hidden bg-linear-to-b from-sky-100/20"
  >
    <div
      class="mx-auto max-w-7xl pt-10 pb-24 sm:pb-32 lg:grid lg:grid-cols-2 lg:gap-x-8 lg:px-8 lg:py-40"
    >
      <div class="px-6 lg:px-0 lg:pt-4">
        <div class="mx-auto max-w-2xl">
          <div class="max-w-lg">
            {
              content.label && content.topButton && (
                <div class="mt-24 sm:mt-32 lg:mt-16">
                  <a
                    href={content.topButton.link}
                    class="inline-flex space-x-6"
                  >
                    <span class="rounded-full bg-sky-50 px-3 py-1 text-sm/6 font-semibold text-sky-600 ring-1 ring-sky-600/20 ring-inset">
                      {content.label}
                    </span>
                    <span class="inline-flex items-center space-x-2 text-sm/6 font-medium text-gray-600">
                      <span>{content.topButton.label}</span>
                      <ChevronRightIcon
                        aria-hidden="true"
                        className="size-5 text-gray-400"
                      />
                    </span>
                  </a>
                </div>
              )
            }
            <h1
              class="mt-10 text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-6xl"
            >
              {content.title}
            </h1>
            <p
              class="mt-8 text-lg font-medium text-pretty text-gray-500 sm:text-xl/8"
            >
              {content.description}
            </p>
            <div class="mt-10 flex items-center gap-x-6">
              <a
                href={content.primaryButton.link}
                class="rounded-md bg-sky-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-sky-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600"
              >
                {content.primaryButton.label}
              </a>
              <a
                href={content.secondaryButton.link}
                class="text-sm/6 font-semibold text-gray-900"
              >
                {content.secondaryButton.label}{" "}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      <div
        class="mt-20 sm:mt-24 md:mx-auto md:max-w-2xl lg:mx-0 lg:mt-0 lg:w-screen"
      >
        <div
          aria-hidden="true"
          class="absolute inset-y-0 right-1/2 -z-10 -mr-10 w-[200%] skew-x-[-30deg] bg-white shadow-xl ring-1 shadow-sky-600/10 ring-sky-50 md:-mr-20 lg:-mr-36"
        >
        </div>
        <div class="shadow-lg md:rounded-3xl">
          <div
            class="bg-sky-500 [clip-path:inset(0)] md:[clip-path:inset(0_round_var(--radius-3xl))]"
          >
            <div
              aria-hidden="true"
              class="absolute -inset-y-px left-1/2 -z-10 ml-10 w-[200%] skew-x-[-30deg] bg-sky-100 opacity-20 inset-ring inset-ring-white md:ml-20 lg:ml-36"
            >
            </div>
            <div class="relative px-6 pt-8 sm:pt-16 md:pr-0 md:pl-16">
              <div class="mx-auto max-w-2xl md:mx-0 md:max-w-none">
                <div class="w-screen overflow-hidden rounded-tl-xl bg-gray-900">
                  <div class="flex bg-gray-800/40 ring-1 ring-white/5">
                    <div class="p-6 w-full">
                      <Image
                        src={image}
                        alt={imageAlt}
                        class="rounded-tl-xl object-cover max-h-[60vh]"
                      />
                    </div>
                  </div>
                </div>
              </div>
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 ring-1 ring-black/10 ring-inset md:rounded-3xl"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="absolute inset-x-0 bottom-0 -z-10 h-24 bg-linear-to-t from-white sm:h-32"
    >
    </div>
  </div>
</div>
