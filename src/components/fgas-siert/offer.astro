---
import { Image } from "astro:assets";
import image1 from "../../content/servizi/assistenza-celle-frigorifere-3.jpg";
const image1Alt = "";
import image2 from "../../content/servizi/assistenza-banchi-frigo-2.jpg";
const image2Alt = "";
import image3 from "../../content/servizi/assistenza-impianti-stagionatura-3.jpg";
const image3Alt = "";
import image4 from "../../content/servizi/assistenza-impianti-stagionatura-2.jpg";
const image4Alt = "";
---

<div class="bg-gray-50 py-24 sm:py-32">
  <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
    <h2 class="text-center text-base/7 font-semibold text-sky-600">
      Pianifica ora per non pensarci più
    </h2>
    <p
      class="mx-auto mt-2 max-w-lg text-center text-4xl font-semibold tracking-tight text-balance text-gray-950 sm:text-5xl"
    >
      Sottoscrivi un contratto di manutenzione programmata
    </p>
    <div class="mt-10 grid gap-4 sm:mt-16 lg:grid-cols-3 lg:grid-rows-2">
      <div class="relative lg:row-span-2">
        <div class="absolute inset-px rounded-lg bg-white lg:rounded-l-4xl">
        </div>
        <div
          class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] lg:rounded-l-[calc(2rem+1px)]"
        >
          <div class="px-8 pt-8 pb-3 sm:px-10 sm:pt-10 sm:pb-0">
            <p
              class="mt-2 text-lg font-medium tracking-tight text-gray-950 max-lg:text-center"
            >
              Chiamata
            </p>
            <p class="mt-2 max-w-lg text-sm/6 text-gray-600 max-lg:text-center">
              Ti chiamo io quando scade la revisione. Niente promemoria sul
              calendario.
            </p>
          </div>
          <div
            class="@container relative min-h-120 w-full grow max-lg:mx-auto max-lg:max-w-sm"
          >
            <div
              class="absolute inset-x-10 top-10 bottom-0 overflow-hidden rounded-t-[12cqw] border-x-[3cqw] border-t-[3cqw] border-gray-700 bg-gray-900 shadow-2xl"
            >
              <Image
                src={image1}
                alt={image1Alt}
                class="size-full object-cover object-top"
              />
            </div>
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/5 lg:rounded-l-4xl"
        >
        </div>
      </div>
      <div class="relative max-lg:row-start-1">
        <div class="absolute inset-px rounded-lg bg-white max-lg:rounded-t-4xl">
        </div>
        <div
          class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-t-[calc(2rem+1px)]"
        >
          <div class="px-8 pt-8 sm:px-10 sm:pt-10">
            <p
              class="mt-2 text-lg font-medium tracking-tight text-gray-950 max-lg:text-center"
            >
              Guasti
            </p>
            <p class="mt-2 max-w-lg text-sm/6 text-gray-600 max-lg:text-center">
              In caso di guasti hai la priorità in caso di guasti urgenti
              durante l'anno.
            </p>
          </div>
          <div
            class="flex flex-1 items-center justify-center px-8 max-lg:pt-10 max-lg:pb-12 sm:px-10 lg:pb-12 rounded-xl py-6"
          >
            <Image
              src={image2}
              alt={image2Alt}
              class="w-full max-lg:max-w-xs rounded-xl"
            />
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/5 max-lg:rounded-t-4xl"
        >
        </div>
      </div>
      <div class="relative max-lg:row-start-3 lg:col-start-2 lg:row-start-2">
        <div class="absolute inset-px rounded-lg bg-white"></div>
        <div
          class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)]"
        >
          <div class="px-8 pt-8 sm:px-10 sm:pt-10">
            <p
              class="mt-2 text-lg font-medium tracking-tight text-gray-950 max-lg:text-center"
            >
              Sicurezza
            </p>
            <p class="mt-2 max-w-lg text-sm/6 text-gray-600 max-lg:text-center">
              Hai la garanzia di un impianto sempre a norma, sicuro e
              controllato.
            </p>
          </div>
          <div
            class="flex flex-1 items-center justify-center px-8 max-lg:pt-10 max-lg:pb-12 sm:px-10 lg:pb-12 rounded-xl py-6"
          >
            <Image
              src={image3}
              alt={image3Alt}
              class="w-full max-lg:max-w-xs rounded-xl"
            />
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/5"
        >
        </div>
      </div>
      <div class="relative lg:row-span-2">
        <div
          class="absolute inset-px rounded-lg bg-white max-lg:rounded-b-4xl lg:rounded-r-4xl"
        >
        </div>
        <div
          class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-r-[calc(2rem+1px)]"
        >
          <div class="px-8 pt-8 pb-3 sm:px-10 sm:pt-10 sm:pb-0">
            <p
              class="mt-2 text-lg font-medium tracking-tight text-gray-950 max-lg:text-center"
            >
              Burocrazia
            </p>
            <p class="mt-2 max-w-lg text-sm/6 text-gray-600 max-lg:text-center">
              Lascio a te la tranquillità di lavorare, mi prendo io l'onere
              delle scartoffie.
            </p>
          </div>
          <div class="relative min-h-120 w-full grow">
            <Image
              src={image4}
              alt={image4Alt}
              class="object-cover h-full pt-10 pl-10 rounded-xl"
            />
          </div>
        </div>
        <div
          class="pointer-events-none absolute inset-px rounded-lg shadow-sm outline outline-black/5 max-lg:rounded-b-4xl lg:rounded-r-4xl"
        >
        </div>
      </div>
    </div>
  </div>
</div>
