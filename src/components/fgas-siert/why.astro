---
import { type FeatureItem } from "../../utils";
import { KeyIcon, UsersIcon, WrenchIcon } from "@heroicons/react/24/outline";

export type HomeValuePropositionContent = {
  title: string;
  description: string;
  features: FeatureItem[];
};

// Value proposition content
const content: HomeValuePropositionContent = {
  title: "Altri motivi per fare la manutenzione",
  description:
    "Ancora non sei convinto? Ecco altri tre motivi per cui ti conviene mantenere il tuo impianto refrigerante al top.",
  features: [
    {
      icon: KeyIcon,
      title: "Eviti Sanzioni Pesanti:",
      description:
        "Le multe per mancata manutenzione o mancata tenuta del libretto vanno da un minimo di 500€ fino a oltre 3.000€. Il costo della manutenzione è una frazione di queste cifre.",
    },
    {
      icon: WrenchIcon,
      title: "Risparmi in Bolletta",
      description:
        "Un impianto sporco, con poco gas o filtri intasati consuma fino al 30% in più. Pulire e tarare la macchina significa abbassare i costi fissi.",
    },
    {
      icon: UsersIcon,
      title: "Sicurezza e Igiene:",
      description:
        "Respirare aria sana è fondamentale. La manutenzione include la sanificazione delle batterie per prevenire muffe, batteri e Legionella.",
    },
  ],
};
---

<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:mx-0">
      <h2
        class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
      >
        {content.title}
      </h2>
      <p class="mt-6 text-lg/8 text-gray-600">{content.description}</p>
    </div>
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl
        class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3"
      >
        {
          content.features.map((feature) => (
            <div class="flex flex-col">
              <dt class="text-base/7 font-semibold text-gray-900">
                <div class="mb-6 flex size-10 items-center justify-center rounded-lg bg-sky-600">
                  <feature.icon
                    aria-hidden="true"
                    className="size-6 text-white"
                  />
                </div>
                {feature.title}
              </dt>
              <dd class="mt-1 flex flex-auto flex-col text-base/7 text-gray-600">
                <p class="flex-auto">{feature.description}</p>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</div>
