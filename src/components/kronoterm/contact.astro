---
import { Image } from "astro:assets";
import ContactForm from "../../components/form.tsx";
import image from "../../content/servizi/assistenza-pompe-calore-1.jpg";
const imageAlt = "Centro assistenza autorizzato Kronoterm";
---

<div class="relative bg-white">
  <div class="lg:absolute lg:inset-0 lg:left-1/2">
    <Image
      src={image}
      alt={imageAlt}
      class="h-64 w-full bg-gray-50 object-cover sm:h-80 lg:absolute lg:h-full"
    />
  </div>
  <div
    class="pt-16 pb-24 sm:pt-24 sm:pb-32 lg:mx-auto lg:grid lg:max-w-7xl lg:grid-cols-2 lg:pt-32"
  >
    <div class="px-6 lg:px-8">
      <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
        <h2
          class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 sm:text-5xl"
        >
          Cerchi un pezzo di ricambio originale?
        </h2>
        <p class="mt-2 text-lg/8 text-gray-600">
          Sei un installatore, un manutentore o un privato e hai bisogno di
          sostituire un componente? Fornisco ricambi originali Kronoterm
          certificati.
        </p>
        <p class="mt-2 text-lg/8 text-gray-600">
          ATTENZIONE: Leggere prima di richiedere. Le pompe di calore cambiano
          componentistica in base all'anno e alla versione. Per identificare il
          ricambio corretto al 100% ed evitare errori di spedizione, è
          obbligatorio fornire il Numero di Matricola (Serial Number) della
          macchina. Senza matricola, non possiamo garantire la compatibilità del
          pezzo.
        </p>
        <div class="mt-16">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </div>
</div>
